[Unit]
Description=Home Assistant Fleet Manager
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/ha-fleet-manager
EnvironmentFile=/opt/ha-fleet-manager/.env.local
ExecStart=/opt/ha-fleet-manager/.venv/bin/uvicorn fleet_manager.app:app --host 0.0.0.0 --port 8799
Restart=always
RestartSec=5
NoNewPrivileges=true

[Install]
WantedBy=default.target
